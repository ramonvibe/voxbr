# LiveKit Cloud: Settings > API Keys (projeto na região São Paulo)
LIVEKIT_URL=wss://<projeto>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# OpenAI: platform.openai.com > API keys
OPENAI_API_KEY=


# Painel
SESSION_SECRET=          # string aleatória longa
ADMIN_EMAIL=             # administrador criado na primeira subida da API
ADMIN_PASSWORD=
DATABASE_URL=postgresql+psycopg://voxbr:voxbr@127.0.0.1:5435/voxbr
# COOKIE_SECURE=true     # em produção (HTTPS)
